{
    "id": "org.freedesktop.LinuxAudio.Plugins.SpectMorph",
    "runtime": "org.freedesktop.LinuxAudio.BaseExtension",
    "runtime-version": "stable",
    "sdk": "org.freedesktop.Sdk//25.08",
    "build-extension": true,
    "branch": "25.08",
    "build-options": {
        "prefix": "/app/extensions/Plugins/SpectMorph",
        "prepend-pkg-config-path": "/app/extensions/Plugins/SpectMorph/lib/pkgconfig",
        "append-ld-library-path": "/app/extensions/Plugins/SpectMorph/lib"
    },
    "cleanup": [
        "/bin",
        "/include",
        "/lib/lv2",
        "/lib/pkgconfig",
        "/share/man",
        "/share/applications",
        "/share/pixmaps",
        "*.a",
        "*.la"
    ],
    "modules": [
        "shared-modules/linux-audio/lv2.json",
        "shared-modules/linux-audio/fftw3f-static.json",
        {
            "name": "spectmorph",
            "build-options": {
                "ldflags": "-L/app/extensions/Plugins/SpectMorph/lib -lfftw3f -lfftw3f_threads"
            },
            "config-opts": [
                "--without-qt",
                "--without-jack",
                "--without-ao"
            ],
            "post-install": [
                "install -d $FLATPAK_DEST/lv2",
                "mv $FLATPAK_DEST/lib/lv2/spectmorph.lv2 $FLATPAK_DEST/lv2",
                "mv $FLATPAK_DEST/lib/vst $FLATPAK_DEST",
                "mv $FLATPAK_DEST/lib/clap $FLATPAK_DEST",
                "strip $FLATPAK_DEST/lv2/spectmorph.lv2/spectmorph_lv2.so",
                "strip $FLATPAK_DEST/vst/spectmorph_vst.so",
                "strip $FLATPAK_DEST/clap/SpectMorph.clap",
                "install -Dm644 org.freedesktop.LinuxAudio.Plugins.SpectMorph.metainfo.xml -t $FLATPAK_DEST/share/metainfo"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/swesterfeld/spectmorph/releases/download/1.0.0-beta3/spectmorph-1.0.0-beta3.tar.bz2",
                    "sha256": "3d6efe2ebb84a6cf813bb7ebcd574f435058116dbeaeee431cfd8a0f9f0d5c35"
                },
                {
                    "type": "file",
                    "url": "https://github.com/swesterfeld/spectmorph-instruments/releases/download/1.0.0-beta3/spectmorph-instruments-1.0.0-beta3.tar.xz",
                    "sha256": "63c97dbeb71dc4180b2cfcaf45174d1a50caec6135564511755dbfd3cf737bb7",
                    "dest": "data"
                },
                {
                    "type": "file",
                    "path": "org.freedesktop.LinuxAudio.Plugins.SpectMorph.metainfo.xml"
                }
            ]
        }
    ]
}
